{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidd0368.github.io/industry-intelligence-hub/schemas/analysis-record.schema.json",
  "title": "Industry Intelligence Analysis Record",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "created_at",
    "updated_at",
    "analysis_type",
    "industry_id",
    "taxonomy_version_used",
    "source",
    "narrative",
    "findings",
    "financials",
    "operating_assumptions",
    "segment_estimates",
    "metric_claims",
    "relationships",
    "mentioned_entities",
    "evidence",
    "derived_metrics",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{8}-[0-9]{6}-[A-Z0-9]{4,8}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "analysis_type": {
      "enum": [
        "broker_report",
        "earnings_call",
        "industry_report",
        "image_screenshot",
        "interview_notes",
        "news",
        "company_filing",
        "multi_source",
        "other"
      ]
    },
    "industry_id": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version_used": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "enum": [
        "accepted",
        "review_required",
        "rejected"
      ],
      "default": "accepted"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "source_type",
        "title",
        "published_date",
        "received_date",
        "files"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "received_date": {
          "type": "string"
        },
        "dropbox_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidentiality": {
          "enum": [
            "private",
            "restricted",
            "public",
            "unknown"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "size": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mime_type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "narrative": {
      "type": "object",
      "required": [
        "executive_summary",
        "expanded_report"
      ],
      "properties": {
        "executive_summary": {
          "type": "string"
        },
        "expanded_report": {
          "type": "string"
        },
        "investment_implications": {
          "type": "string"
        },
        "industry_cross_checks": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "title",
          "detail",
          "fact_type",
          "confidence",
          "evidence_ids"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "fact_type": {
            "enum": [
              "disclosed_actual",
              "management_guidance",
              "analyst_estimate",
              "industry_estimate",
              "model_inference",
              "qualitative_claim"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "financials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metricClaim"
      }
    },
    "operating_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "category",
          "description",
          "fact_type",
          "confidence",
          "evidence_ids"
        ],
        "properties": {
          "assumption_id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "industry",
              "price",
              "shipment",
              "capacity",
              "utilization",
              "gross_margin",
              "operating_margin",
              "new_product",
              "new_technology",
              "market_share",
              "new_customer",
              "customer_mix",
              "segment_mix",
              "yield",
              "lead_time",
              "capex",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "reference_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "fact_type": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "segment_estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "segment_name",
          "reference_period",
          "value_type",
          "value",
          "unit",
          "fact_type",
          "evidence_ids"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "segment_name": {
            "type": "string"
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference_period": {
            "type": "string"
          },
          "value_type": {
            "enum": [
              "revenue",
              "revenue_mix",
              "growth",
              "shipment",
              "capacity",
              "other"
            ]
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "fact_type": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metric_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metricClaim"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "from_entity_id",
          "to_entity_id",
          "relationship_type",
          "confidence",
          "evidence_ids"
        ],
        "properties": {
          "relationship_id": {
            "type": "string"
          },
          "from_entity_id": {
            "type": "string"
          },
          "to_entity_id": {
            "type": "string"
          },
          "relationship_type": {
            "enum": [
              "supplier",
              "customer",
              "competitor",
              "substitute",
              "partner",
              "manufacturer",
              "packager",
              "equipment_supplier",
              "investor",
              "potential_beneficiary",
              "potential_headwind",
              "other"
            ]
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "mentioned_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "name",
          "reason_mentioned"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ticker": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_mentioned": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_id",
          "locator",
          "excerpt",
          "supports"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "context": {
            "type": [
              "string",
              "null"
            ]
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "derived_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "derived_id",
          "name",
          "formula",
          "result",
          "unit",
          "input_claim_ids",
          "assumptions"
        ],
        "properties": {
          "derived_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "result": {},
          "unit": {
            "type": "string"
          },
          "input_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sensitivity": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "schema_valid",
        "taxonomy_ids_valid",
        "units_checked",
        "periods_checked",
        "conflicts_found",
        "review_notes"
      ],
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "taxonomy_ids_valid": {
          "type": "boolean"
        },
        "units_checked": {
          "type": "boolean"
        },
        "periods_checked": {
          "type": "boolean"
        },
        "conflicts_found": {
          "type": "integer",
          "minimum": 0
        },
        "review_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "metricClaim": {
      "type": "object",
      "required": [
        "claim_id",
        "entity_id",
        "node_id",
        "metric_id",
        "as_of_date",
        "reference_period",
        "value_type",
        "value",
        "unit",
        "fact_type",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "metric_id": {
          "type": "string"
        },
        "as_of_date": {
          "type": "string"
        },
        "reference_period": {
          "type": "string"
        },
        "value_type": {
          "enum": [
            "point",
            "range",
            "minimum",
            "maximum",
            "growth_rate",
            "multiple",
            "date",
            "qualitative"
          ]
        },
        "value": {},
        "value_low": {},
        "value_high": {},
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "fact_type": {
          "enum": [
            "disclosed_actual",
            "management_guidance",
            "analyst_estimate",
            "industry_estimate",
            "model_inference",
            "qualitative_claim"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
