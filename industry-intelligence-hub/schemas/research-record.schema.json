{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidd0368.github.io/industry-intelligence-hub/schemas/research-record.schema.json",
  "title": "Industry Intelligence Research Record",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "analysis",
    "taxonomy",
    "sources",
    "entities",
    "claims",
    "github_write"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "pattern": "^IIH-[0-9]{8}-[A-Z0-9-]+$"
    },
    "analysis": {
      "type": "object",
      "required": [
        "title",
        "created_at",
        "language",
        "expanded_report",
        "executive_summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "language": {
          "const": "zh-Hant"
        },
        "executive_summary": {
          "type": "string"
        },
        "expanded_report": {
          "type": "string"
        },
        "operating_inflection": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counter_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "industry_id",
        "version_used"
      ],
      "properties": {
        "industry_id": {
          "type": "string"
        },
        "version_used": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_type",
          "title"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "published_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "dropbox_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_quality": {
            "type": "string"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "name",
          "mention_reason"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ticker": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "mention_reason": {
            "type": "string"
          }
        }
      }
    },
    "financial_forecasts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "business_segments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "metric_id",
          "as_of_date",
          "reference_period",
          "claim_type",
          "source_refs",
          "confidence",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "entity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "metric_id": {
            "type": "string"
          },
          "as_of_date": {
            "type": "string"
          },
          "reference_period": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "min_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "max_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_type": {
            "enum": [
              "actual",
              "company_guidance",
              "broker_estimate",
              "industry_estimate",
              "derived",
              "rumor",
              "management_comment"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "original_quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "calculation": {
            "type": [
              "object",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "enum": [
              "accepted",
              "review_required",
              "superseded",
              "rejected"
            ]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "taxonomy_proposals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "github_write": {
      "type": "object",
      "required": [
        "repository",
        "inbox_path",
        "commit_message"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "inbox_path": {
          "type": "string"
        },
        "commit_message": {
          "type": "string"
        },
        "records_path": {
          "type": "string"
        },
        "changelog_path": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
