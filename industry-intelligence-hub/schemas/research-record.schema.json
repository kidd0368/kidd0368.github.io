{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidd0368.github.io/industry-intelligence-hub/schemas/research-record.schema.json",
  "title": "Industry Intelligence Research Record",
  "type": "object",
  "required": ["schema_version", "task_id", "taxonomy_version_used", "analysis_date", "sources", "entities", "claims", "expanded_report"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{8}-[A-Z0-9]{4,12}$"},
    "taxonomy_version_used": {"type": "string", "minLength": 1},
    "analysis_date": {"type": "string", "format": "date"},
    "analysis_type": {"type": "string"},
    "title": {"type": "string"},
    "status": {"enum": ["accepted", "review_required", "rejected"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_type", "title", "as_of_date"],
        "properties": {
          "source_id": {"type": "string"},
          "source_type": {"type": "string"},
          "title": {"type": "string"},
          "publisher": {"type": ["string", "null"]},
          "as_of_date": {"type": "string"},
          "file_name": {"type": ["string", "null"]},
          "file_hash": {"type": ["string", "null"]},
          "dropbox_path": {"type": ["string", "null"]},
          "confidentiality": {"enum": ["public", "private", "restricted"]}
        },
        "additionalProperties": true
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "name", "reason_mentioned"],
        "properties": {
          "entity_id": {"type": "string"},
          "name": {"type": "string"},
          "ticker": {"type": ["string", "null"]},
          "country": {"type": ["string", "null"]},
          "reason_mentioned": {"type": "string"}
        }
      }
    },
    "financials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "period"],
        "properties": {
          "entity_id": {"type": "string"},
          "period": {"type": "string"},
          "revenue": {"type": ["number", "null"]},
          "net_income": {"type": ["number", "null"]},
          "eps": {"type": ["number", "null"]},
          "currency": {"type": ["string", "null"]},
          "estimate_type": {"enum": ["actual", "company_guidance", "broker_estimate", "derived", "not_available"]},
          "source_id": {"type": ["string", "null"]},
          "page_ref": {"type": ["string", "null"]}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "category", "description"],
        "properties": {
          "assumption_id": {"type": "string"},
          "category": {"type": "string"},
          "description": {"type": "string"},
          "source_id": {"type": ["string", "null"]},
          "page_ref": {"type": ["string", "null"]}
        }
      }
    },
    "segment_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "segment", "period"],
        "properties": {
          "entity_id": {"type": "string"},
          "segment": {"type": "string"},
          "period": {"type": "string"},
          "revenue": {"type": ["number", "null"]},
          "revenue_share": {"type": ["number", "null"]},
          "currency": {"type": ["string", "null"]},
          "source_id": {"type": ["string", "null"]},
          "page_ref": {"type": ["string", "null"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "entity_id", "node_id", "metric_id", "reference_period", "estimate_type", "evidence_status"],
        "properties": {
          "claim_id": {"type": "string"},
          "entity_id": {"type": "string"},
          "node_id": {"type": "string"},
          "metric_id": {"type": "string"},
          "reference_period": {"type": "string"},
          "value": {"type": ["number", "string", "null"]},
          "value_min": {"type": ["number", "null"]},
          "value_base": {"type": ["number", "null"]},
          "value_max": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]},
          "currency": {"type": ["string", "null"]},
          "estimate_type": {"enum": ["actual", "company_guidance", "broker_estimate", "industry_estimate", "derived"]},
          "source_id": {"type": ["string", "null"]},
          "page_ref": {"type": ["string", "null"]},
          "evidence_excerpt": {"type": ["string", "null"]},
          "evidence_status": {"enum": ["direct", "chart_read", "inferred", "missing"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "status": {"enum": ["accepted", "review_required", "rejected"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "relationships": {"type": "array"},
    "taxonomy_proposals": {"type": "array"},
    "derived_metrics": {"type": "array"},
    "expanded_report": {"type": "string", "minLength": 1},
    "change_summary": {"type": "array"},
    "validation_notes": {"type": "array"}
  },
  "additionalProperties": true
}
